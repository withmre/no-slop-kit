{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.development)",
      "Read(.env.production)",
      "Read(.env.development.local)",
      "Read(.env.production.local)",
      "Read(./secrets/**)",
      "Read(package-lock.json)",
      "Read(pnpm-lock.yaml)",
      "Read(yarn.lock)",
      "Read(bun.lock)",
      "Read(./dist/**)",
      "Read(./build/**)",
      "Read(./.next/**)",
      "Read(./coverage/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)"
    ]
  }
}
